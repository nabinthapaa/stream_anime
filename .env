# Local development defaults. Nothing secret lives here.
# Real environment overrides win: the Dockerfile's ENV and k8s/configMap.yaml
# take precedence over this file, so it only shapes `npm run dev`/`npm run build`.

# Base URL the server components use to call this app's own /api routes.
# Next inlines NEXT_PUBLIC_* at BUILD time, so changing this needs a rebuild,
# not just a restart. In a container, point it at the app itself
# (http://localhost:3000) rather than a public URL.
NEXT_PUBLIC_HOSTNAME=http://localhost:3000

# Where the catalogue and video sources are scraped from.
SCRAPE_WEBSITE=https://animeheaven.me
